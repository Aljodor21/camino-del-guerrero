# Copia este archivo a .env.docker y rellena los valores reales
# El archivo .env.docker NUNCA debe subirse a git

SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=False
ALLOWED_HOSTS=localhost,uburoom,192.168.1.XXX,camino.servelejo.site

# Base de datos — DB_HOST=db apunta al contenedor de PostgreSQL
DB_NAME=camino_db
DB_USER=camino_user
DB_PASSWORD=cambia-esto-por-una-password-segura
DB_HOST=db
DB_PORT=5432

# Estas las lee el contenedor de PostgreSQL directamente (mismo valor que arriba)
POSTGRES_DB=camino_db
POSTGRES_USER=camino_user
POSTGRES_PASSWORD=cambia-esto-por-una-password-segura

# IA
# Claude (SDK oficial de Anthropic): AI_PROVIDER=anthropic, AI_MODEL=claude-opus-5-5,
#   AI_API_KEY = tu clave de console.anthropic.com. AI_BASE_URL no se usa.
# Otros con formato OpenAI (Groq, DeepSeek): AI_PROVIDER=openai y su AI_BASE_URL sin /v1.
AI_PROVIDER=anthropic
AI_BASE_URL=
AI_MODEL=claude-opus-5-5
AI_API_KEY=tu-api-key-aqui

# CORS — solo necesario si accedes desde un origen diferente
CORS_ALLOWED_ORIGINS=http://localhost,http://uburoom:8085,https://camino.servelejo.site
CSRF_TRUSTED_ORIGINS=https://camino.servelejo.site


# Puerto en el que corre la app en uburoom (8080 lo usa ntfy, 80 el panel de warden)
APP_PORT=8085

# Usuario administrador de la app (se crea automáticamente al iniciar)
ADMIN_EMAIL=admin@camino.com
ADMIN_PASSWORD=cambia-esto
ADMIN_NOMBRE=Administrador

# Notificaciones al celular. Generar con: docker compose exec backend python manage.py llaves_push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# Firebase (avisos a la app instalada). El .json de la cuenta de servicio, en base64 y en una sola línea:
# base64 -w0 camino-...-firebase-adminsdk-....json
FIREBASE_CREDENCIALES_B64=

# Correo (recuperar la clave y bienvenida). Con Gmail: smtp.gmail.com,
# puerto 587 y una "contraseña de aplicación". Sin EMAIL_HOST el correo sale en el log del backend:
#   docker compose --env-file .env.docker logs backend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
# Dirección desde la que se abre la app: el enlace del correo apunta aquí (ej. http://localhost:8080)
FRONTEND_URL=https://camino.servelejo.site

# Imagen orientativa del cambio estimado (OpenAI). Sin OPENAI_API_KEY la función no aparece.
OPENAI_API_KEY=
# Opcionales: el modelo de imágenes, su calidad (low, medium, high) y cuántas imágenes por persona al día
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# OPENAI_IMAGE_QUALITY=medium
# ILUSTRACIONES_POR_DIA=3
