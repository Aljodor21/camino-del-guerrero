# Copia este archivo a .env.docker y rellena los valores reales
# El archivo .env.docker NUNCA debe subirse a git

SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=False
ALLOWED_HOSTS=localhost,uburoom,192.168.1.XXX

# Base de datos — DB_HOST=db apunta al contenedor de PostgreSQL
DB_NAME=camino_db
DB_USER=camino_user
DB_PASSWORD=cambia-esto-por-una-password-segura
DB_HOST=db
DB_PORT=5432

# IA (Groq u otro proveedor)
AI_PROVIDER=openai
AI_BASE_URL=https://api.groq.com/openai
AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=tu-api-key-aqui

# CORS — solo necesario si accedes desde un origen diferente
CORS_ALLOWED_ORIGINS=http://localhost,http://uburoom

# Puerto en el que corre la app en CasaOS (por defecto 80)
APP_PORT=8080

# Usuario administrador de la app (se crea automáticamente al iniciar)
ADMIN_EMAIL=admin@camino.com
ADMIN_PASSWORD=cambia-esto
ADMIN_NOMBRE=Administrador
