# Copia este archivo a backend/.env y rellena los valores reales.
# backend/.env NUNCA debe subirse a git (ya está en .gitignore).

SECRET_KEY=genera-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos — para local apuntando a un servidor remoto, usa su host/puerto reales
DB_NAME=camino_db
DB_USER=camino_user
DB_PASSWORD=tu_password
DB_HOST=localhost
DB_PORT=5432

# IA — proveedor compatible con OpenAI (Groq, DeepSeek, etc.) u Ollama local
AI_PROVIDER=openai
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
AI_API_KEY=tu_api_key

# Opcionales
YOUTUBE_API_KEY=
GIPHY_API_KEY=

# CORS — origen del frontend en local (ng serve)
CORS_ALLOWED_ORIGINS=http://localhost:4200
CSRF_TRUSTED_ORIGINS=http://localhost:4200

# Solo si vas a usar el comando `crear_admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador
